DreamScene360/

# Generated themes, logs and timing data
server/outputs/
server/*.log
**/timings.csv
**/*.jsonl

# Secrets
**/api_config.yaml
**/api_config.json
.env

# Survey data (available on request, never committed)
*.xlsx

# Unity: client/unity/.gitignore excludes everything Unity regenerates (Library/, Temp/,
# Logs/, UserSettings/, *.csproj, *.sln) and installed third-party content. Commit every .meta file.

