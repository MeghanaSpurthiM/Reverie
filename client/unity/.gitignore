# Unity project: everything Unity regenerates when it opens the project.
# Keep Assets/ (with every .meta), Packages/manifest.json, Packages/packages-lock.json and ProjectSettings/.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# IDE and tool folders
.vs/
.vscode/
.idea/
.gradle/
.gstack/
.consulo/
ExportedObj/

# Generated by Unity or IDEs
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# Build outputs
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta

# Third-party content that is installed, not committed (see the top-level README, "Install")
# TextMesh Pro Essential Resources: imported on first open by TmpEssentialsImporter.
/[Aa]ssets/TextMesh Pro/
/[Aa]ssets/TextMesh Pro.meta
# Asset Store packs, Meta samples and other imported packages
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Samples/
/[Aa]ssets/Samples.meta
/[Aa]ssets/Plugins/Editor/JetBrains*

# Secrets: real API keys live only in these local files. Commit api_config.example.json instead.
/[Aa]ssets/StreamingAssets/api_config.yaml
/[Aa]ssets/StreamingAssets/api_config.yaml.meta
/[Aa]ssets/StreamingAssets/api_config.json
/[Aa]ssets/StreamingAssets/api_config.json.meta
